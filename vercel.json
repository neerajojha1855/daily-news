{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/dist/$1"
        }
    ],
    "crons": [
        {
            "path": "/api/v1/internal/refresh-news",
            "schedule": "*/15 * * * *"
        }
    ]
}