# Environment
DEBUG=False
ENVIRONMENT=production

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Or configure components:
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dailynews

# External News Provider (NewsAPI.org / GNews.io)
NEWS_API_PROVIDER=newsapi
NEWS_API_KEY=your_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & Authentication (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
SESSION_SECRET=replace_with_another_secure_string_at_least_32_characters_long
CRON_SECRET=replace_with_cron_authorization_secret_token

# CORS & Frontend URLs
FRONTEND_URL=https://your-domain.vercel.app
CORS_ORIGINS=["https://your-domain.vercel.app", "http://localhost:5173"]
