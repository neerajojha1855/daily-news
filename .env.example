# Copy this file to backend/.env and replace every CHANGE_ME value.
# Never commit backend/.env or any file containing real credentials.

# Application
ENVIRONMENT=development
DEBUG=true

# PostgreSQL database (Neon, Supabase, Railway, or another PostgreSQL provider)
# Use the pooled connection URL for serverless production deployments.
DATABASE_URL=CHANGE_ME_POSTGRES_CONNECTION_STRING

# Optional alternative to DATABASE_URL:
# DB_USER=CHANGE_ME
# DB_PASSWORD=CHANGE_ME
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dailynews

# News provider: newsapi, gnews, or newsdata
NEWS_API_PROVIDER=newsapi
NEWS_API_KEY=CHANGE_ME
NEWS_API_BASE_URL=https://newsapi.org/v2

# Required only when NEWS_API_PROVIDER=newsdata
NEWS_DATA_API_KEY=CHANGE_ME
NEWS_DATA_BASE_URL=https://newsdata.io/api/1

# Google Gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL_NAME=gemini-2.5-flash

# Authentication secrets (use long random values in production)
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
SESSION_SECRET=CHANGE_ME_USE_A_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

# Required by the scheduled internal news refresh endpoint
CRON_SECRET=CHANGE_ME

# Frontend and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
